# os/voice environment. Copy to .env (gitignored) and fill in the values.
# Every value is empty here on purpose. Secrets have no defaults anywhere in the code.
# Names follow JARVIS-2.0 where it had one. See voice/config.py for how each is read.

# --- LiveKit worker connection (required) -------------------------------------------
# ws://localhost:7880 for the compose server. The key pair must match LIVEKIT_KEYS that
# docker-compose.voice.yml hands to the server; generate one with
# `docker run --rm livekit/livekit-server:latest generate-keys`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Leave empty for automatic dispatch. A value switches LiveKit to explicit dispatch and
# then needs a dispatch rule or token that names the agent.
LIVEKIT_AGENT_NAME=

# --- Speech to text ---------------------------------------------------------------
# openai (default, gpt-4o-mini-transcribe) or deepgram. Only the chosen provider's key is required.
STT_PROVIDER=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# --- Models -----------------------------------------------------------------------
# Local model through Ollama's OpenAI-compatible endpoint (default http://localhost:11434/v1).
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Optional cloud model for heavy and tool routes. Setting a model requires OPENAI_API_KEY.
# CLOUD_LLM_BASE_URL points the same client at another OpenAI-compatible provider.
CLOUD_LLM_MODEL=
CLOUD_LLM_BASE_URL=

# --- Kokoro text to speech (required) ---------------------------------------------
# Full base URL including the port; the compose service listens on http://localhost:8880/v1.
KOKORO_URL=
KOKORO_VOICE=
KOKORO_API_KEY=

# --- Memory -----------------------------------------------------------------------
# inmemory (default) or mem0. mem0 needs mem0ai installed plus the Postgres settings below.
MEMORY_BACKEND=
MEMORY_RECALL_LIMIT=
MEMORY_FALLBACK_USER_ID=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MEM0_COLLECTION=
MEM0_EMBED_MODEL=
MEM0_EMBED_DIMS=
MEM0_LLM_MODEL=

# --- Turn handling ----------------------------------------------------------------
# Barge-in thresholds (seconds of speech, words) before the agent stops talking.
INTERRUPTION_MIN_DURATION=
INTERRUPTION_MIN_WORDS=
GREETING_INSTRUCTIONS=

# --- Router keywords (comma separated, whole-word, case-insensitive) ----------------
ROUTER_TOOL_KEYWORDS=
ROUTER_HEAVY_KEYWORDS=
